{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CIPHER",
  "version": "0.2.0",
  "identifier": "app.cipher.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "CIPHER",
        "width": 480,
        "height": 800,
        "minWidth": 400,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "center": true,
        "backgroundColor": "#08080C"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "AI operating layer for Windows",
    "longDescription": "CIPHER is a local-first AI desktop agent. It understands commands, plans multi-step tasks, operates applications, files, the browser and the terminal — with a mandatory permission system and action verification.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
